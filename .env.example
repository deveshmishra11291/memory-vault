# Cloudflare R2 / AWS S3 Object Storage (Zero Egress Fees for Lifetime Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=memory-vault-storage
R2_PUBLIC_URL=https://media.yourdomain.com

# PostgreSQL / Supabase Database (Optional for remote multi-device sync)
DATABASE_URL=postgresql://postgres:password@db.example.com:5432/memoryvault
